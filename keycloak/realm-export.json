{
  "realm": "learnloop",
  "enabled": true,
  "displayName": "LearnLoop",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": true,
  "accessTokenLifespan": 900,
  "sslRequired": "external",
  "clients": [
    {
      "clientId": "learnloop-web",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "rootUrl": "https://learnloop.ariefspace.xyz",
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:4173/*",
        "https://learnloop.ariefspace.xyz/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:4173",
        "https://learnloop.ariefspace.xyz"
      ],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "role-attribute-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "role",
            "claim.name": "role",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "learnloop-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "learnloop-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "student"
      },
      {
        "name": "teacher"
      },
      {
        "name": "parent"
      }
    ]
  },
  "users": [
    {
      "username": "teacher-demo",
      "enabled": true,
      "email": "teacher@learnloop.local",
      "firstName": "Demo",
      "lastName": "Teacher",
      "attributes": {
        "role": [
          "teacher"
        ]
      },
      "realmRoles": [
        "teacher"
      ],
